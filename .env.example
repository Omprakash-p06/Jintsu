# ==============================================================================
# Reality Check AI (jintru) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` to configure your local runtime:
#   cp .env.example .env
#
# By default, USE_MOCK_PROVIDERS=true allows the full system to run locally
# and pass offline tests and evaluations without external API keys.
# To enable real web search and live LLM verification, set USE_MOCK_PROVIDERS=false
# and provide valid API keys below.
# ==============================================================================

# --- Provider Selection ---
# Set to 'false' to use live Brave Search and Meta/Llama AI providers.
# Set to 'true' for offline deterministic mocking.
USE_MOCK_PROVIDERS=true

# --- Brave Search API ---
# Obtain from https://brave.com/search/api/ (Required when USE_MOCK_PROVIDERS=false)
BRAVE_API_KEY=

# Retrieval mode: "snippets" (default web search) or "context" (LLM context passages)
BRAVE_RETRIEVAL_MODE=snippets

# --- LLM Synthesis Provider (Meta / OpenAI compatible) ---
# API key for structured chat completion (Required when USE_MOCK_PROVIDERS=false)
META_API_KEY=

# Endpoint base URL (e.g., https://api.meta.ai/v1, https://api.groq.com/openai/v1, or local vLLM/Ollama)
META_API_BASE_URL=https://api.meta.ai/v1

# Target model identifier
META_MODEL=muse-spark-1.3

# --- Storage & SLA Budget ---
# Relative or absolute path to SQLite database
DATABASE_PATH=data/jintru.db

# Monotonic SLA request deadline in seconds (authoritative 8.0s hard ceiling)
REQUEST_DEADLINE_SECONDS=8.0

# Search query caching toggle (prevents repeated external API calls)
CACHE_ENABLED=true

# --- Frontend Configuration ---
# API base URL for frontend client (relative /api/v1 uses Next.js proxy rewrite)
NEXT_PUBLIC_API_BASE_URL=/api/v1
PORT=3000
